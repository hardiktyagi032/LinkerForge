  "optimizer": "AdamW",
  "learning_rate": 0.0003,
  "max_gpu_hours_total": 6,
  "max_seconds_per_trial": 1800,
  "development_selection": "masked residue APS on filtered development set",
  "external_benchmark_once_after_freeze": "CAID3 common-27 APS, AUC-ROC, Fmax; never tune on these scores",
