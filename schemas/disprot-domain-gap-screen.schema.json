{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/richennacht/LinkerForge/schemas/disprot-domain-gap-screen.schema.json",
  "title": "DisProt domain-gap review candidate, not a linker label",
  "type": "object",
  "required": ["schema_version", "record_type", "disprot_id", "uniprot_accession", "domain_a", "domain_b", "gap", "disorder_evidence", "review_status", "provenance"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "record_type": {"const": "disprot_domain_gap_screen_not_linker_label"},
    "disprot_id": {"type": "string", "pattern": "^DP[0-9]+$"},
    "uniprot_accession": {"type": "string", "minLength": 1},
    "sequence_length": {"type": "integer", "minimum": 1},
    "domain_a": {"$ref": "#/$defs/domain"},
    "domain_b": {"$ref": "#/$defs/domain"},
    "gap": {"type": "object", "required": ["start", "end", "sequence", "length"], "properties": {
      "start": {"type": "integer", "minimum": 1}, "end": {"type": "integer", "minimum": 1},
      "sequence": {"type": "string", "minLength": 5, "maxLength": 30},
      "length": {"type": "integer", "minimum": 5, "maximum": 30}
    }},
    "disorder_evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["region_id", "start", "end", "overlap_residues"], "properties": {
      "region_id": {"type": "string"}, "start": {"type": "integer"}, "end": {"type": "integer"},
      "overlap_residues": {"type": "integer", "minimum": 1}
    }}},
    "review_status": {"const": "pending"},
    "provenance": {"type": "object", "required": ["source_id", "source_sha256", "pipeline_commit", "config_sha256", "software", "evidence_quality"], "properties": {
      "source_id": {"type": "string"},
      "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
      "pipeline_commit": {"type": "string"},
      "config_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
      "software": {"type": "object"},
      "evidence_quality": {"const": "screening_only"}
    }}
  },
  "$defs": {"domain": {"type": "object", "required": ["pfam_id", "start", "end"], "properties": {
    "pfam_id": {"type": "string"}, "start": {"type": "integer", "minimum": 1},
    "end": {"type": "integer", "minimum": 1}
  }}}
}
