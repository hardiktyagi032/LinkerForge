{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/richennacht/LinkerForge/schemas/dfl_positive_candidate_v0.1.0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "protein_id", "sequence", "labels", "positive_regions", "training_eligibility", "provenance"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "record_type": {"const": "disprot_dfl_positive_candidate"},
    "protein_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "string", "pattern": "^[A-Z]+$"},
    "labels": {"type": "string", "pattern": "^[1x]+$"},
    "training_eligibility": {"const": "candidate_pending_homology_and_annotation_audit"},
    "positive_regions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["region_id", "start_1based", "end_1based", "reference_id", "eco_id", "release", "evidence_quality"],
        "properties": {
          "region_id": {"type": "string", "minLength": 1},
          "start_1based": {"type": "integer", "minimum": 1},
          "end_1based": {"type": "integer", "minimum": 1},
          "reference_id": {"type": "string", "minLength": 1},
          "eco_id": {"type": "string", "minLength": 1},
          "release": {"type": "string", "minLength": 1},
          "evidence_quality": {"const": "curated_disprot_flexible_linker_region_not_independent_domain_pair_adjudication"}
        }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["source_url", "source_sha256", "script_sha256", "config_sha256", "pipeline_commit", "software"],
      "properties": {
        "source_url": {"type": "string", "format": "uri"},
        "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "script_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "config_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "pipeline_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "software": {"type": "object"}
      }
    }
  }
}
