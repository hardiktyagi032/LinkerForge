{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/richennacht/LinkerForge/schemas/dfl_unknown_review_queue_v0.1.0.schema.json",
  "title": "DFL unknown-residue review queue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "selection", "records", "provenance", "warning"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "status": {"const": "annotation_review_queue_not_ground_truth"},
    "selection": {"type": "string"},
    "warning": {"type": "string"},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protein_id", "start_1based", "end_1based", "sequence", "mean_model_score", "source_label", "evidence_quality"],
        "properties": {
          "protein_id": {"type": "string", "minLength": 1},
          "start_1based": {"type": "integer", "minimum": 1},
          "end_1based": {"type": "integer", "minimum": 1},
          "sequence": {"type": "string", "pattern": "^[A-Z]+$"},
          "mean_model_score": {"type": "number", "minimum": 0, "maximum": 1},
          "source_label": {"const": "x_masked_unknown"},
          "evidence_quality": {"const": "unadjudicated_model_nominated"}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_sha256", "checkpoint_sha256", "script_sha256", "pipeline_commit"],
      "properties": {
        "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "checkpoint_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "script_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "pipeline_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      }
    }
  }
}
