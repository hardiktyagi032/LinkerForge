{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkerforge.local/schemas/published-dfl-splits-manifest.schema.json",
  "type": "object",
  "required": ["schema_version", "status", "caid3_reference_sha256", "converter_sha256", "pipeline_commit", "splits"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "status": {"const": "prepared_masked_retrospective_splits_not_fresh_independent_test"},
    "caid3_reference_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "converter_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "pipeline_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "splits": {
      "type": "object",
      "required": ["TR166", "TE82", "TE64"],
      "additionalProperties": {"$ref": "#/$defs/split"}
    }
  },
  "$defs": {
    "split": {
      "type": "object",
      "required": ["assignment", "source_sha256", "output_sha256", "records", "positive_residues", "negative_residues", "masked_residues", "zero_positive_proteins"],
      "properties": {
        "assignment": {"enum": ["train_original", "development_original", "retrospective_test_original"]},
        "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "output_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "records": {"type": "integer", "minimum": 0},
        "positive_residues": {"type": "integer", "minimum": 0},
        "negative_residues": {"type": "integer", "minimum": 0},
        "masked_residues": {"type": "integer", "minimum": 0},
        "zero_positive_proteins": {"type": "integer", "minimum": 0}
      }
    }
  }
}
